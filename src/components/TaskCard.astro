---
import type { Task } from "../types/task";
import { Priority,Status } from "../types/task";
interface Props {
    task: Task;
}

const { task } = Astro.props
---

<section class="
     w-screen h-screen bg-mist-700 flex justify-center m-auto
">
    <div class="
     w-2xl h-auto bg-mist-900 flex flex-col items-center  m-auto rounded-2xl py-8 space-y-4 border-2 border-gray-200
     shadow-lg shadow-blue-600
    ">
        <h2 class=" text-3xl drop-shadow-sm drop-shadow-blue-500 text-center text-cyan-500">Tarea</h2>
        <h3 class=" text-2xl text-center ">{task.title}</h3>   
        <h3 class=" text-3xl drop-shadow-sm drop-shadow-blue-500 text'center text-cyan-500">Descripción</h3>
        <p class=" text-xl text-center">{task.description}</p>
        <h3 class=" text-3xl drop-shadow-sm drop-shadow-blue-500 text-center text-cyan-500">Prioridad</h3>
        <p class=" text-xl text-center">{Priority[task.priority]}</p>
        <h3 class=" text-3xl drop-shadow-sm drop-shadow-blue-500 text-center text-cyan-500">Estado</h3>
        <p class=" text-xl text-center">{Status[task.status]}</p>
        <h3 class=" text-3xl drop-shadow-sm drop-shadow-blue-500 text-center text-cyan-500">Fecha</h3>
        <p class=" text-xl text-center">{task.createdAt.toLocaleDateString()}</p>
    </div>

</section>