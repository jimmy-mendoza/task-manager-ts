---
import type { Task } from "../types/task";

interface Props {
    task: Task;
}

const { task } = Astro.props
---

<section class="
     max-w-full max-h-full bg-amber-100 flex justify-center m-auto
">
    <div class="
     w-3xl h-auto bg-amber-400 flex justify-center m-auto  
    ">
        <h2>Tarea</h2>
        <h3>{task.title}</h3>
        <div>
            <h3>Descricion</h3>
            <p>{task.description}</p>
        </div>
        <h3>Prioridad</h3>
        <p>{task.priority}</p>
        <h3>Estado</h3>
        <p>{task.status}</p>
        <h3>Fecha</h3>
        <p>{task.createdAt}</p>
    </div>

</section>