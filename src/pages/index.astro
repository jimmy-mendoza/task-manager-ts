---
import TaskCard from "../components/TaskCard.astro"
import { Priority, Status } from "../types/task"
import type { Task } from "../types/task.ts"
import "../styles/global.css"

const TaskList: Task[] = [
	{id: 1, title: "Tarea 1", description: "Descripción generica 1", status: Status.Completed, priority: Priority.Medium, createdAt: new Date()},
	{id: 2, title: "Tarea 2", description: "Descripción generica 2", status: Status.InProgress, priority: Priority.Low, createdAt: new Date()},
	{id: 3, title: "Tarea 3", description: "Descripción generica 3", status: Status.Pending, priority: Priority.High, createdAt: new Date()},
	{id: 4, title: "Tarea 4", description: "Descripción generica 4", status: Status.Completed, priority: Priority.High, createdAt: new Date()}
]


---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro</title>
	</head>
	<body class="max-h-full max-w-full font-grotesk text-amber-50" >
		{TaskList.map((task)=> <TaskCard task={task} />)}
	</body>
</html>
